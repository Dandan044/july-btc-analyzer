# 敏感文件
.ssh/
credentials/
.openclaw/credentials.json
*.env
*.key
*.pem
*.p12

# 代理凭证
memory/mihomo-proxy.md
scripts/test_with_proxy.py
gost-config.yaml
vpnurl.txt

# 日志 — 保留目录结构（.gitkeep）
logs/*
!logs/.gitkeep
*.log

# 数据 — 保留 SCHEMA.md，其余排除
data/*
!data/SCHEMA.md
data/kline_chart.png
data/kline_charts/

# 警报规则 — 保留目录结构（.gitkeep）
skills/btc-alert/rules/*
!skills/btc-alert/rules/.gitkeep
skills/btc-alert/rules-archive/*
!skills/btc-alert/rules-archive/.gitkeep
skills/btc-alert/rules-state.json

# 动态运行时数据（不需要版本控制）
active/
archived/
.openclaw/workspace-state.json
.openclaw/workspace-state-backup.json
cycle-health/
memory/

# 代理配置（用户本地配置，不提交）
config/proxy.env

# 临时文件
*.tmp
*.bak
*.bak.*
node_modules/
.cache/.env
scripts/__pycache__/
tmp_gen_manifest.py

# 不需要版本控制的目录
.trash/
market-brief/
images/
dashboard/public/images/

# stray files from misinvoked CLI args
1:
--cycle
